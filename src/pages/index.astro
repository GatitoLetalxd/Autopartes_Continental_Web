---
// index.astro
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Configurador3D from '../components/Configurador3D.astro';
import Catalogo from '../components/Catalogo.astro';
import Galeria from '../components/Galeria.astro';
import Nosotros from '../components/Nosotros.astro';
import Testimonios from '../components/Testimonios.astro';
import FAQ from '../components/FAQ.astro';
import Contacto from '../components/Contacto.astro';
---

<Layout>
  <Hero />

  <!-- Quick Data Bar — UI/UX Pro Max: dark glass premium redesign -->
  <div id="data-bar" class="relative bg-[rgba(10,10,12,0.95)] border-y border-[rgba(245,197,24,0.18)] backdrop-blur-xl overflow-hidden">
    <!-- Ambient line glow -->
    <div class="absolute inset-0 bg-gradient-to-r from-[rgba(245,197,24,0.04)] via-[rgba(245,197,24,0.08)] to-[rgba(245,197,24,0.04)] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-5">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-[rgba(245,197,24,0.12)]">

        <!-- Dirección -->
        <div class="dato-rapido flex items-center justify-center gap-3 py-3 sm:py-0 sm:px-6">
          <div class="w-8 h-8 rounded-lg bg-[rgba(245,197,24,0.1)] border border-[rgba(245,197,24,0.2)] flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-[#F5C518]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <span class="text-[rgba(245,245,245,0.85)] font-semibold text-sm sm:text-base tracking-wide text-center leading-tight">
            Av. Andrés Avelino Cáceres — Puerto Maldonado
          </span>
        </div>

        <!-- Teléfonos -->
        <div class="dato-rapido flex items-center justify-center gap-3 py-3 sm:py-0 sm:px-6">
          <div class="w-8 h-8 rounded-lg bg-[rgba(245,197,24,0.1)] border border-[rgba(245,197,24,0.2)] flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-[#F5C518]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </div>
          <a href="tel:+51921123803" class="text-[rgba(245,245,245,0.85)] hover:text-[#F5C518] font-semibold text-sm sm:text-base tracking-wide transition-colors cursor-pointer">
            921 123 803 / 925 724 735
          </a>
        </div>

        <!-- Horario -->
        <div class="dato-rapido flex items-center justify-center gap-3 py-3 sm:py-0 sm:px-6">
          <div class="w-8 h-8 rounded-lg bg-[rgba(245,197,24,0.1)] border border-[rgba(245,197,24,0.2)] flex items-center justify-center flex-shrink-0">
            <svg class="w-4 h-4 text-[#F5C518]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <span class="text-[rgba(245,245,245,0.85)] font-semibold text-sm sm:text-base tracking-wide">
            Lun – Sáb: 8am – 6pm
          </span>
        </div>

      </div>
    </div>
  </div>

  <Servicios />
  <Configurador3D />
  <Catalogo />
  <Galeria />
  <Nosotros />
  <Testimonios />
  <FAQ />
  <Contacto />
</Layout>

<script>
  import { initAll } from '../scripts/animations.js';
  document.addEventListener('DOMContentLoaded', () => {
    initAll();
  });
</script>
