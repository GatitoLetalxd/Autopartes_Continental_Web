---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppBtn from '../components/WhatsAppBtn.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Autopartes Continental | Puerto Maldonado',
  description = 'Venta de autopartes, instalación de aire acondicionado, servicio eléctrico automotriz y más en Puerto Maldonado, Perú.'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="autopartes, Puerto Maldonado, Madre de Dios, taller automotriz, aire acondicionado, eléctrico automotriz, polarizados" />
    <meta name="author" content="Autopartes Continental" />

    <!-- Open Graph -->
    <meta property="og:title" content="Autopartes Continental" />
    <meta property="og:description" content="Tu taller de confianza en Puerto Maldonado" />
    <meta property="og:image" content="/img/hero_bg.jpg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Autopartes Continental" />
    <meta name="twitter:description" content="Tu taller de confianza en Puerto Maldonado" />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/png" href="/img/logo.png" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <!-- Local Business Schema Markup (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "AutoRepair",
        "name": "Autopartes Continental",
        "image": "https://autopartes-continental.vercel.app/img/foto_local.jpg",
        "@id": "https://autopartes-continental.vercel.app/#organization",
        "url": "https://autopartes-continental.vercel.app",
        "telephone": "+51921123803",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Av. Andrés Avelino Cáceres",
          "addressLocality": "Puerto Maldonado",
          "addressRegion": "Madre de Dios",
          "addressCountry": "PE"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -12.5925,
          "longitude": -69.1932
        },
        "openingHoursSpecification": [
          {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday"
            ],
            "opens": "08:00",
            "closes": "18:00"
          }
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+51921123803",
          "contactType": "customer service",
          "areaServed": "PE",
          "availableLanguage": "Spanish"
        },
        "sameAs": [
          "https://wa.me/51921123803"
        ]
      }
    </script>
  </head>
  <body class="bg-[#111111] text-[#F5F5F5] font-[Inter,sans-serif] overflow-x-hidden">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppBtn />
    <SpeedInsights />
  </body>
</html>
