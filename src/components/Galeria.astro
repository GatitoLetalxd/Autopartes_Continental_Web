---
// Galeria.astro

const trabajos = [
  {
    tipo: "video",
    src: "/img/video_instalacion_de_sonido.mp4",
    titulo: "Instalación de Sonido",
    categoria: "Audio",
    id: "video-sonido",
    span: "col-span-1 sm:col-span-2 row-span-2" // Make the video prominent in the grid
  },
  {
    tipo: "imagen",
    src: "/img/techo_de_auto_forrado.jpeg",
    titulo: "Forrado de Techo Premium",
    categoria: "Tapicería",
    span: "col-span-1 row-span-1"
  },
  {
    tipo: "imagen",
    src: "/img/tapiz_de_puerta_forrado.jpeg",
    titulo: "Forrado de Tapiz de Puerta",
    categoria: "Tapicería",
    span: "col-span-1 row-span-1"
  },
  {
    tipo: "imagen",
    src: "/img/techo_de_auto_forrado_2.jpeg",
    titulo: "Forrado de Techo (Detalle)",
    categoria: "Tapicería",
    span: "col-span-1 row-span-1"
  },
  {
    tipo: "imagen",
    src: "/img/Tapices_de_puerta_fabricados.jpeg",
    titulo: "Fabricación de Tapices",
    categoria: "Tapicería",
    span: "col-span-1 sm:col-span-2 row-span-1"
  },
  {
    tipo: "imagen",
    src: "/img/techo_de_auto_forrado_3.jpeg",
    titulo: "Restauración de Techo",
    categoria: "Tapicería",
    span: "col-span-1 row-span-1"
  },
  {
    tipo: "imagen",
    src: "/img/techo_de_auto_forrado_4.jpeg",
    titulo: "Acabado Final Techo",
    categoria: "Tapicería",
    span: "col-span-1 row-span-1"
  }
];
---

<section id="galeria" class="py-20 lg:py-28 bg-[#161616]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col items-center justify-center text-center mb-12 w-full">
      <span class="inline-block text-[#F5C518] text-sm font-semibold uppercase tracking-[0.2em] mb-4">Nuestros Proyectos</span>
      <h2 class="section-titulo text-4xl sm:text-5xl lg:text-6xl text-white mb-4">
        Trabajos <span class="text-[#F5C518]">Realizados</span>
      </h2>
      <div class="w-20 h-1 bg-[#F5C518] rounded-full"></div>
      <p class="mt-6 text-[#F5F5F5]/60 max-w-xl text-base sm:text-lg text-center">
        Un vistazo a la calidad de nuestros servicios, desde tapicería premium hasta instalaciones eléctricas y de audio.
      </p>
    </div>

    <!-- Gallery Container -->
    <!-- Mobile: Horizontal Scroll (CSS Snap). Desktop: CSS Grid Masonry-like -->
    <div class="galeria-grid flex overflow-x-auto snap-x snap-mandatory gap-4 pb-8 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-4 sm:overflow-visible sm:snap-none hide-scrollbar">
      
      {trabajos.map((item, index) => (
        <article
          class={`galeria-item group relative bg-[#111111] border border-white/5 rounded-2xl overflow-hidden flex-shrink-0 snap-center w-[85vw] sm:w-auto h-[300px] sm:h-[250px] lg:h-[300px] ${item.span || ''}`}
        >
          {item.tipo === "imagen" ? (
            <>
              <img
                src={item.src}
                alt={item.titulo}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-80 group-hover:opacity-100 transition-opacity duration-300"></div>
              
              <div class="absolute bottom-0 left-0 right-0 p-5 translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
                <span class="inline-block px-2 py-1 bg-[#F5C518]/20 text-[#F5C518] text-xs font-bold uppercase tracking-wider rounded backdrop-blur-md mb-2">
                  {item.categoria}
                </span>
                <h3 class="text-white font-bold text-lg leading-tight">{item.titulo}</h3>
              </div>
            </>
          ) : (
            // Video Item
            <div class="w-full h-full relative cursor-pointer video-container" data-video-id={item.id}>
              <video
                id={item.id}
                src={item.src}
                class="w-full h-full object-cover"
                preload="metadata"
                playsinline
              ></video>
              
              <!-- Dark Overlay when paused -->
              <div class="video-overlay absolute inset-0 bg-black/40 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                <!-- Play Button -->
                <div class="play-btn w-16 h-16 bg-[#F5C518] rounded-full flex items-center justify-center shadow-lg shadow-[#F5C518]/30 transition-transform duration-300 group-hover:scale-110">
                  <svg class="w-8 h-8 text-[#111111] translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </div>
              </div>

              <!-- Text Info (hidden when playing) -->
              <div class="video-info absolute bottom-0 left-0 right-0 p-5 bg-gradient-to-t from-black/80 to-transparent pointer-events-none">
                <span class="inline-block px-2 py-1 bg-[#F5C518]/20 text-[#F5C518] text-xs font-bold uppercase tracking-wider rounded backdrop-blur-md mb-2">
                  {item.categoria}
                </span>
                <h3 class="text-white font-bold text-xl leading-tight">{item.titulo}</h3>
              </div>
            </div>
          )}
        </article>
      ))}

    </div>
  </div>
</section>

<script>
  // Video interaction logic
  const videoContainers = document.querySelectorAll('.video-container');

  videoContainers.forEach(container => {
    const video = container.querySelector('video') as HTMLVideoElement;
    const overlay = container.querySelector('.video-overlay');
    const info = container.querySelector('.video-info');

    container.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        video.controls = true; // Show native controls once playing so user can adjust volume/scrub
        if (overlay) overlay.classList.add('hidden');
        if (info) info.classList.add('hidden');
      } else {
        video.pause();
        if (overlay) overlay.classList.remove('hidden');
        if (info) info.classList.remove('hidden');
      }
    });

    // When video ends, show overlay again
    video.addEventListener('ended', () => {
      video.controls = false;
      if (overlay) overlay.classList.remove('hidden');
      if (info) info.classList.remove('hidden');
    });
  });
</script>

<style>
  /* Optional: Enhance the video grid cell for larger screens */
  @media (min-width: 640px) {
    .video-container video {
      height: 100%;
    }
    .galeria-item.row-span-2 {
      height: calc(500px + 1rem); /* 2x 250px + gap */
    }
  }
  @media (min-width: 1024px) {
    .galeria-item.row-span-2 {
      height: calc(600px + 1rem); /* 2x 300px + gap */
    }
  }
</style>
