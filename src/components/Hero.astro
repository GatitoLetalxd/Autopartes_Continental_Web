---
// Hero.astro
---

<section id="inicio" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="/img/hero_bg.jpg"
      alt="Taller Autopartes Continental"
      class="w-full h-full object-cover"
      fetchpriority="high"
    />
    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/60 to-black/80"></div>
    <!-- Yellow glow at bottom -->
    <div class="absolute bottom-0 left-0 right-0 h-48 bg-gradient-to-t from-[#F5C518]/10 to-transparent"></div>
  </div>

  <!-- tsParticles canvas -->
  <div id="tsparticles" aria-hidden="true"></div>

  <!-- Hero Content -->
  <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto pt-20">
    <!-- Badge -->
    <div class="hero-badge inline-flex items-center gap-2 bg-[#F5C518]/15 border border-[#F5C518]/40 text-[#F5C518] text-xs sm:text-sm font-semibold px-4 py-2 rounded-full mb-6 uppercase tracking-widest backdrop-blur-sm">
      <span class="w-2 h-2 rounded-full bg-[#F5C518] animate-pulse"></span>
      Puerto Maldonado, Madre de Dios · Perú
    </div>

    <!-- Main Title -->
    <h1 class="hero-titulo font-['Barlow_Condensed'] font-bold text-5xl sm:text-7xl lg:text-8xl xl:text-9xl text-white uppercase leading-none tracking-tight mb-4">
      Autopartes<br />
      <span class="text-[#F5C518]">Continental</span>
    </h1>

    <!-- Subtitle -->
    <p class="hero-subtitulo text-lg sm:text-xl lg:text-2xl text-[#F5F5F5]/80 font-light max-w-2xl mx-auto mb-8 leading-relaxed">
      Tu taller de confianza en Puerto Maldonado
      <span class="block text-[#F5C518]/80 mt-1 text-base sm:text-lg">Autopartes · Servicios · Instalaciones</span>
    </p>

    <!-- CTA Buttons -->
    <div class="hero-botones flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#servicios"
         id="btn-ver-servicios"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#F5C518] hover:bg-[#E8A000] text-[#111111] font-bold text-base sm:text-lg px-8 py-4 rounded-xl transition-all duration-300 hover:scale-105 hover:shadow-[0_0_30px_rgba(245,197,24,0.4)] uppercase tracking-wide">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Ver nuestros servicios
      </a>

      <a href="https://wa.me/51921123803"
         id="btn-whatsapp-hero"
         target="_blank" rel="noopener noreferrer"
         class="w-full sm:w-auto inline-flex items-center justify-center gap-2 border-2 border-[#F5C518] text-[#F5C518] hover:bg-[#F5C518] hover:text-[#111111] font-bold text-base sm:text-lg px-8 py-4 rounded-xl transition-all duration-300 hover:scale-105 uppercase tracking-wide">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.858L.057 23.427a.5.5 0 00.617.617l5.569-1.476A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.96 0-3.793-.553-5.352-1.509l-.383-.228-3.966 1.05 1.05-3.874-.249-.396A9.962 9.962 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
        </svg>
        Contáctanos por WhatsApp
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-16 flex flex-col items-center gap-2 text-white/40 text-xs uppercase tracking-widest">
      <span>Desliza</span>
      <div class="w-px h-12 bg-gradient-to-b from-[#F5C518]/60 to-transparent animate-pulse"></div>
    </div>
  </div>
</section>

<script>
  // tsParticles hero
  (async () => {
    if (typeof window === 'undefined') return;

    const script = document.createElement('script');
    script.src = 'https://cdn.jsdelivr.net/npm/@tsparticles/bundle@3/tsparticles.bundle.min.js';
    script.onload = async () => {
      if (window.tsParticles) {
        await window.tsParticles.load({
          id: 'tsparticles',
          options: {
            fullScreen: { enable: false },
            background: { color: { value: 'transparent' } },
            fpsLimit: 60,
            particles: {
              number: { value: 55, density: { enable: true, area: 900 } },
              color: { value: '#F5C518' },
              opacity: { value: { min: 0.1, max: 0.45 }, animation: { enable: true, speed: 0.5 } },
              size: { value: { min: 1, max: 3 } },
              move: { enable: true, speed: 0.6, direction: 'none', random: true, outModes: 'out' },
              links: { enable: true, color: '#F5C518', opacity: 0.1, distance: 120 },
            },
            interactivity: {
              events: { onHover: { enable: true, mode: 'repulse' } },
              modes: { repulse: { distance: 80, duration: 0.4 } },
            },
            detectRetina: true,
          }
        });
      }
    };
    document.head.appendChild(script);
  })();
</script>
