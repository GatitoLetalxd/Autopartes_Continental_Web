---
// Footer.astro

const servicios = [
  "Equipamiento de vehículos",
  "Aire acondicionado",
  "Servicio eléctrico",
  "Polarizados y tapizados",
  "Parabrisas y parachoques",
  "Venta de autopartes",
];

const horarios = [
  { dia: "Lunes – Viernes", hora: "8:00 am – 6:00 pm" },
  { dia: "Sábado",           hora: "8:00 am – 4:00 pm" },
  { dia: "Domingo",          hora: "Cerrado" },
];
---

<footer class="relative bg-[#0a0a0c] border-t border-[rgba(245,197,24,0.1)] pt-16 pb-6 overflow-hidden">
  <!-- Gradient top glow — Modern Dark Cinema style -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-[rgba(245,197,24,0.3)] to-transparent"></div>
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-48 bg-[rgba(245,197,24,0.04)] rounded-full blur-[80px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Logo + Tagline -->
    <div class="text-center mb-14">
      <img src="/img/logo.png" alt="Autopartes Continental" class="h-16 sm:h-20 w-auto object-contain mx-auto mb-5" loading="lazy" />
      <h2 class="font-['Barlow_Condensed'] font-bold text-2xl sm:text-3xl text-[#F5C518] uppercase tracking-[0.15em]">Autopartes Continental</h2>
      <p class="text-[rgba(245,245,245,0.4)] text-sm mt-2">Tu taller de confianza en Puerto Maldonado</p>
      <!-- Divider -->
      <div class="mt-6 flex items-center justify-center gap-3">
        <div class="h-px w-16 bg-gradient-to-r from-transparent to-[rgba(245,197,24,0.4)]"></div>
        <div class="w-1.5 h-1.5 bg-[#F5C518] rounded-full"></div>
        <div class="h-px w-16 bg-gradient-to-l from-transparent to-[rgba(245,197,24,0.4)]"></div>
      </div>
    </div>

    <!-- 3 Columns -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 mb-14">

      <!-- Col 1: Servicios -->
      <div>
        <h3 class="font-['Barlow_Condensed'] font-bold text-base text-[#F5C518] uppercase tracking-[0.2em] mb-6 flex items-center gap-2">
          <span class="w-5 h-px bg-[rgba(245,197,24,0.4)]"></span>
          Servicios
        </h3>
        <ul class="space-y-2">
          {servicios.map(s => (
            <li>
              <a href="#servicios" class="text-[rgba(245,245,245,0.5)] hover:text-[#F5C518] text-sm transition-colors duration-200 flex items-center gap-2.5 group/link">
                <span class="w-1 h-1 rounded-full bg-[rgba(245,197,24,0.4)] group-hover/link:bg-[#F5C518] transition-colors flex-shrink-0"></span>
                {s}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Contacto -->
      <div>
        <h3 class="font-['Barlow_Condensed'] font-bold text-base text-[#F5C518] uppercase tracking-[0.2em] mb-6 flex items-center gap-2">
          <span class="w-5 h-px bg-[rgba(245,197,24,0.4)]"></span>
          Contacto
        </h3>
        <ul class="space-y-4 text-sm text-[rgba(245,245,245,0.5)]">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-[#F5C518] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="leading-relaxed">Av. Andrés Avelino Cáceres c/ Cecilia Areque, frente a Petroperú<br />Puerto Maldonado, Madre de Dios</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-[#F5C518] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <div>
              <a href="tel:+51921123803" class="hover:text-[#F5C518] transition-colors block cursor-pointer">921 123 803</a>
              <a href="tel:+51925724735" class="hover:text-[#F5C518] transition-colors block cursor-pointer">925 724 735</a>
            </div>
          </li>
          <li>
            <a href="https://wa.me/51921123803"
               target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-2 bg-[rgba(37,211,102,0.08)] border border-[rgba(37,211,102,0.25)] text-[#25D366] hover:bg-[rgba(37,211,102,0.15)] px-4 py-2.5 rounded-xl text-sm transition-all duration-200 font-medium cursor-pointer">
              <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.858L.057 23.427a.5.5 0 00.617.617l5.569-1.476A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.96 0-3.793-.553-5.352-1.509l-.383-.228-3.966 1.05 1.05-3.874-.249-.396A9.962 9.962 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
              </svg>
              Escribir al WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Horarios -->
      <div>
        <h3 class="font-['Barlow_Condensed'] font-bold text-base text-[#F5C518] uppercase tracking-[0.2em] mb-6 flex items-center gap-2">
          <span class="w-5 h-px bg-[rgba(245,197,24,0.4)]"></span>
          Horarios
        </h3>
        <ul class="space-y-3">
          {horarios.map(h => (
            <li class="flex justify-between items-center border-b border-[rgba(255,255,255,0.05)] pb-3">
              <span class="text-[rgba(245,245,245,0.5)] text-sm">{h.dia}</span>
              <span class={`font-semibold text-sm ${h.hora === 'Cerrado' ? 'text-red-400/80' : 'text-white'}`}>{h.hora}</span>
            </li>
          ))}
        </ul>

        <!-- Urgency note -->
        <div class="mt-6 bg-[rgba(245,197,24,0.05)] border border-[rgba(245,197,24,0.15)] rounded-xl p-4">
          <p class="text-[#F5C518] font-bold text-sm mb-1">¿Necesitas atención urgente?</p>
          <p class="text-[rgba(245,245,245,0.5)] text-xs leading-relaxed">Escríbenos por WhatsApp al 921 123 803 o 925 724 735. Te respondemos lo antes posible.</p>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-[rgba(255,255,255,0.06)] pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-[rgba(245,245,245,0.3)] text-xs text-center sm:text-left">
        © 2025 Autopartes Continental — Puerto Maldonado, Perú. Todos los derechos reservados.
      </p>
      <div class="flex items-center gap-5">
        <a href="#inicio"    class="text-[rgba(245,245,245,0.3)] hover:text-[#F5C518] text-xs transition-colors">Inicio</a>
        <a href="#servicios" class="text-[rgba(245,245,245,0.3)] hover:text-[#F5C518] text-xs transition-colors">Servicios</a>
        <a href="#contacto"  class="text-[rgba(245,245,245,0.3)] hover:text-[#F5C518] text-xs transition-colors">Contacto</a>
      </div>
    </div>
  </div>
</footer>
