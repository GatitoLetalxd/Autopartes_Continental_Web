---
// Servicios.astro

const servicios = [
  {
    id: 1,
    nombre: "Equipamiento de Vehículos",
    desc: "Equipamos todo tipo de vehículos con los mejores accesorios y repuestos del mercado.",
    img: "/img/autos.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>`,
  },
  {
    id: 2,
    nombre: "Aire Acondicionado",
    desc: "Instalación, mantenimiento y recarga de aire acondicionado para cualquier modelo de vehículo.",
    img: "/img/servicio_ac.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.59 4.59A2 2 0 1111 8H2m10.59 11.41A2 2 0 1010 16H2m15.73-8.27A2 2 0 1119 12H2" /></svg>`,
  },
  {
    id: 3,
    nombre: "Servicio Eléctrico Automotriz",
    desc: "Diagnóstico y reparación de sistemas eléctricos, batería, alternador y arranque.",
    img: "/img/servicio_electrico.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
  {
    id: 4,
    nombre: "Polarizados, Tapizados y Faros",
    desc: "Polarizado de lunas, tapizado interior y mantenimiento de faros delanteros y traseros.",
    img: "/img/servicio_polarizado.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>`,
  },
  {
    id: 5,
    nombre: "Parachoques y Parabrisas",
    desc: "Instalación y reemplazo de parabrisas, lunas laterales y parachoques delantero/trasero.",
    img: "/img/servicio_parabrisas.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" /></svg>`,
  },
  {
    id: 6,
    nombre: "Venta de Autopartes",
    desc: "Amplio catálogo de repuestos originales y alternativos para todas las marcas y modelos.",
    img: "/img/autos.jpg",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>`,
  },
];
---

<section id="servicios" class="py-20 lg:py-28 bg-[#111111]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section Header -->
    <div class="flex flex-col items-center justify-center text-center mb-16 w-full">
      <span class="inline-block text-[#F5C518] text-sm font-semibold uppercase tracking-[0.2em] mb-4">Lo que hacemos</span>
      <h2 class="section-titulo text-4xl sm:text-5xl lg:text-6xl text-white mb-4">
        Nuestros <span class="text-[#F5C518]">Servicios</span>
      </h2>
      <div class="w-20 h-1 bg-[#F5C518] rounded-full"></div>
      <p class="mt-6 text-[#F5F5F5]/60 max-w-xl text-base sm:text-lg text-center">
        Ofrecemos soluciones completas para tu vehículo con técnicos certificados y repuestos de calidad.
      </p>
    </div>

    <!-- Services Grid: flex-wrap ensures centered rows even when incomplete -->
    <div class="flex flex-wrap justify-center gap-6 lg:gap-8">
      {servicios.map((s) => (
        <article
          class="servicio-card group relative bg-[#1a1a1a] border border-white/5 rounded-2xl overflow-hidden cursor-default w-full sm:w-[calc(50%-12px)] lg:w-[calc(33.333%-22px)]"
          id={`servicio-${s.id}`}
        >
          <!-- Image -->
          <div class="relative h-52 overflow-hidden">
            <img
              src={s.img}
              alt={s.nombre}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <!-- Image overlay gradient -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a] via-transparent to-transparent opacity-80"></div>
            <!-- Yellow corner accent -->
            <div class="absolute top-4 right-4 w-10 h-10 bg-[#F5C518] rounded-xl flex items-center justify-center text-[#111111] shadow-lg shadow-[#F5C518]/20">
              <Fragment set:html={s.icon} />
            </div>
          </div>

          <!-- Content -->
          <div class="p-6">
            <h3 class="font-['Barlow_Condensed'] font-bold text-xl sm:text-2xl text-white mb-2 uppercase tracking-wide group-hover:text-[#F5C518] transition-colors">
              {s.nombre}
            </h3>
            <p class="text-[#F5F5F5]/60 text-sm leading-relaxed mb-4">
              {s.desc}
            </p>
            <a
              href={`https://wa.me/51921123803?text=Hola, me interesa el servicio de ${encodeURIComponent(s.nombre)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-[#F5C518] text-sm font-semibold hover:gap-3 transition-all duration-200"
              aria-label={`Consultar sobre ${s.nombre} por WhatsApp`}
            >
              Consultar por WhatsApp
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>

          <!-- Bottom accent line -->
          <div class="absolute bottom-0 left-0 right-0 h-0.5 bg-[#F5C518] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
        </article>
      ))}
    </div>
  </div>
</section>
