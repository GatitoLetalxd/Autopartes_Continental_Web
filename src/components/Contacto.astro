---
// Contacto.astro

const horarios = [
  { dia: "Lunes - Viernes", hora: "8:00 am – 6:00 pm" },
  { dia: "Sábado",          hora: "8:00 am – 4:00 pm" },
  { dia: "Domingo",         hora: "Cerrado" },
];

const serviciosSelect = [
  "Equipamiento de vehículos",
  "Instalación de aire acondicionado",
  "Servicio eléctrico automotriz",
  "Polarizados, tapizados y faros",
  "Parachoques y parabrisas",
  "Venta de autopartes",
  "Otro / Consulta general",
];
---

<section id="contacto" class="py-20 lg:py-28 bg-[#2A2A2A]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-[#F5C518] text-sm font-semibold uppercase tracking-[0.2em] mb-4">Estamos para servirte</span>
      <h2 class="section-titulo text-4xl sm:text-5xl lg:text-6xl text-white mb-4">
        <span class="text-[#F5C518]">Contáctanos</span>
      </h2>
      <div class="w-20 h-1 bg-[#F5C518] mx-auto rounded-full"></div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16">

      <!-- LEFT: Info + Map -->
      <div class="contacto-info space-y-8">
        <!-- Contact cards -->
        <div class="space-y-4">
          <!-- Address -->
          <div class="flex items-start gap-4 bg-[#1a1a1a] border border-white/5 rounded-2xl p-5">
            <div class="w-10 h-10 bg-[#F5C518] rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div>
              <p class="text-[#F5C518] font-bold text-sm uppercase tracking-wide mb-1">Dirección</p>
              <p class="text-white font-medium">Av. Andrés Avelino Cáceres c/ Cecilia Areque</p>
              <p class="text-[#F5F5F5]/60 text-sm">(Frente a Petroperú) – Puerto Maldonado, Madre de Dios</p>
            </div>
          </div>

          <!-- Phones -->
          <div class="flex items-start gap-4 bg-[#1a1a1a] border border-white/5 rounded-2xl p-5">
            <div class="w-10 h-10 bg-[#F5C518] rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <p class="text-[#F5C518] font-bold text-sm uppercase tracking-wide mb-1">Teléfonos / WhatsApp</p>
              <a href="tel:+51921123803" class="text-white font-medium hover:text-[#F5C518] transition-colors block">921 123 803</a>
              <a href="tel:+51925724735" class="text-white font-medium hover:text-[#F5C518] transition-colors block">925 724 735</a>
            </div>
          </div>

          <!-- Hours -->
          <div class="bg-[#1a1a1a] border border-white/5 rounded-2xl p-5">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 bg-[#F5C518] rounded-xl flex items-center justify-center">
                <svg class="w-5 h-5 text-[#111111]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <p class="text-[#F5C518] font-bold text-sm uppercase tracking-wide">Horarios</p>
            </div>
            <div class="space-y-2">
              {horarios.map(h => (
                <div class="flex justify-between items-center">
                  <span class="text-[#F5F5F5]/70 text-sm">{h.dia}</span>
                  <span class={`font-semibold text-sm ${h.hora === 'Cerrado' ? 'text-red-400' : 'text-white'}`}>{h.hora}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Google Maps -->
        <div class="rounded-2xl overflow-hidden border border-white/10 h-52 sm:h-64">
          <iframe
            title="Ubicación de Autopartes Continental en Puerto Maldonado"
            src="https://maps.google.com/maps?q=Auto+Partes+Continental,+Puerto+Maldonado,+Peru&output=embed&z=17"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <!-- Direct WhatsApp CTA -->
        <a href="https://wa.me/51921123803?text=Hola, me comunico desde la web de Autopartes Continental"
           target="_blank" rel="noopener noreferrer"
           id="btn-whatsapp-contacto-directo"
           class="flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#1ebe5d] text-white font-bold text-base sm:text-lg px-6 py-4 rounded-2xl transition-all duration-200 hover:scale-[1.02] w-full shadow-lg shadow-[#25D366]/20">
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.858L.057 23.427a.5.5 0 00.617.617l5.569-1.476A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.96 0-3.793-.553-5.352-1.509l-.383-.228-3.966 1.05 1.05-3.874-.249-.396A9.962 9.962 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
          </svg>
          Escríbenos directamente al 921 123 803
        </a>
      </div>

      <!-- RIGHT: Form -->
      <div>
        <form id="contacto-form" class="space-y-5" novalidate aria-label="Formulario de contacto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Name -->
            <div>
              <label for="form-nombre" class="block text-[#F5C518] text-sm font-semibold uppercase tracking-wide mb-2">Nombre *</label>
              <input
                id="form-nombre"
                name="nombre"
                type="text"
                required
                placeholder="Tu nombre completo"
                class="w-full bg-[#1a1a1a] border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-white/30 focus:border-[#F5C518] focus:outline-none focus:ring-1 focus:ring-[#F5C518]/30 transition-colors"
              />
            </div>
            <!-- Phone -->
            <div>
              <label for="form-telefono" class="block text-[#F5C518] text-sm font-semibold uppercase tracking-wide mb-2">Teléfono *</label>
              <input
                id="form-telefono"
                name="telefono"
                type="tel"
                required
                placeholder="Tu número de contacto"
                class="w-full bg-[#1a1a1a] border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-white/30 focus:border-[#F5C518] focus:outline-none focus:ring-1 focus:ring-[#F5C518]/30 transition-colors"
              />
            </div>
          </div>

          <!-- Service -->
          <div>
            <label for="form-servicio" class="block text-[#F5C518] text-sm font-semibold uppercase tracking-wide mb-2">Servicio</label>
            <select
              id="form-servicio"
              name="servicio"
              class="w-full bg-[#1a1a1a] border border-white/10 rounded-xl px-4 py-3 text-white focus:border-[#F5C518] focus:outline-none focus:ring-1 focus:ring-[#F5C518]/30 transition-colors appearance-none cursor-pointer"
            >
              <option value="" disabled selected>Selecciona un servicio</option>
              {serviciosSelect.map(s => (
                <option value={s}>{s}</option>
              ))}
            </select>
          </div>

          <!-- Message -->
          <div>
            <label for="form-mensaje" class="block text-[#F5C518] text-sm font-semibold uppercase tracking-wide mb-2">Mensaje</label>
            <textarea
              id="form-mensaje"
              name="mensaje"
              rows="4"
              placeholder="Cuéntanos en qué podemos ayudarte..."
              class="w-full bg-[#1a1a1a] border border-white/10 rounded-xl px-4 py-3 text-white placeholder:text-white/30 focus:border-[#F5C518] focus:outline-none focus:ring-1 focus:ring-[#F5C518]/30 transition-colors resize-none"
            ></textarea>
          </div>

          <!-- Submit -->
          <button
            type="submit"
            id="btn-enviar-form"
            class="w-full bg-[#F5C518] hover:bg-[#E8A000] text-[#111111] font-bold text-base px-6 py-4 rounded-xl transition-all duration-200 hover:scale-[1.02] uppercase tracking-wide flex items-center justify-center gap-2"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.533 5.858L.057 23.427a.5.5 0 00.617.617l5.569-1.476A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.96 0-3.793-.553-5.352-1.509l-.383-.228-3.966 1.05 1.05-3.874-.249-.396A9.962 9.962 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
            </svg>
            Enviar por WhatsApp
          </button>

          <p class="text-center text-[#F5F5F5]/40 text-xs">
            Al enviar, serás redirigido a WhatsApp con tu mensaje prellenado.
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contacto-form') as HTMLFormElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const nombre   = (document.getElementById('form-nombre')   as HTMLInputElement).value.trim();
    const telefono = (document.getElementById('form-telefono') as HTMLInputElement).value.trim();
    const servicio = (document.getElementById('form-servicio') as HTMLSelectElement).value;
    const mensaje  = (document.getElementById('form-mensaje')  as HTMLTextAreaElement).value.trim();

    if (!nombre || !telefono) {
      alert('Por favor, completa tu nombre y teléfono.');
      return;
    }

    const texto = [
      `Hola, me comunico desde su web.`,
      `*Nombre:* ${nombre}`,
      `*Teléfono:* ${telefono}`,
      servicio ? `*Servicio:* ${servicio}` : '',
      mensaje  ? `*Mensaje:* ${mensaje}`   : '',
    ].filter(Boolean).join('\n');

    const url = `https://wa.me/51921123803?text=${encodeURIComponent(texto)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });
</script>
