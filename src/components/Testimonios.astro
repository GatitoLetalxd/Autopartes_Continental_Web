---
// Testimonios.astro

const testimonios = [
  {
    id: 1,
    nombre: "Juan Carlos R.",
    rol: "Propietario de Toyota Hilux",
    servicio: "Servicio Eléctrico",
    rating: 5,
    texto: "El servicio eléctrico de mi camioneta quedó impecable. Tenía un problema complejo con el alternador y lo diagnosticaron y solucionaron el mismo día. La atención en Puerto Maldonado es insuperable.",
    avatar: "JR",
  },
  {
    id: 2,
    nombre: "María Fernanda S.",
    rol: "Cliente Frecuente",
    servicio: "Repuestos y Filtros",
    rating: 5,
    texto: "Excelente atención. Compré pastillas de frenos y filtros de aire para mi auto. Me asesoraron con mucha paciencia sobre la compatibilidad de marcas y los precios son súper competitivos.",
    avatar: "MS",
  },
  {
    id: 3,
    nombre: "Carlos Delgado M.",
    rol: "Conductor Local",
    servicio: "Aire Acondicionado",
    rating: 5,
    texto: "Con el calor intenso que hace en Madre de Dios, el aire acondicionado es indispensable. La instalación quedó perfecta y enfría rapidísimo. El equipo técnico realmente sabe lo que hace.",
    avatar: "CD",
  },
  {
    id: 4,
    nombre: "Pedro Mendoza V.",
    rol: "Propietario de Hyundai Accent",
    servicio: "Equipamiento y Parabrisas",
    rating: 5,
    texto: "Muy agradecido con el cambio de mi parabrisas y el polarizado de lunas. Tienen un stock muy completo y la instalación fue rápida y prolija. Se convirtieron en mi taller de confianza.",
    avatar: "PM",
  },
];
---

<section id="testimonios" class="py-20 lg:py-28 bg-[#161619] relative overflow-hidden">
  <!-- Ambient blobs -->
  <div class="ambient-blob absolute w-[500px] h-[500px] bg-[rgba(245,197,24,0.04)] -top-32 -left-32 pointer-events-none" aria-hidden="true"></div>
  <div class="ambient-blob ambient-blob-2 absolute w-[400px] h-[400px] bg-[rgba(245,197,24,0.03)] -bottom-24 -right-24 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">

    <!-- Header -->
    <div class="section-header flex flex-col items-center justify-center text-center mb-16 w-full">
      <div class="section-badge mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-[#F5C518]"></span>
        Opiniones Reales
      </div>
      <h2 class="section-titulo text-4xl sm:text-5xl lg:text-6xl text-white mb-5">
        Lo que dicen <span class="gradient-text">Nuestros Clientes</span>
      </h2>
      <div class="section-divider"></div>
      <p class="mt-6 text-[rgba(245,245,245,0.55)] max-w-xl text-base sm:text-lg">
        La confianza y seguridad de nuestros conductores en Madre de Dios es nuestra mayor recompensa.
      </p>
    </div>

    <!-- Carousel Container -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-8">

      <!-- Testimonials track -->
      <div class="overflow-hidden">
        <div id="testimonios-track" class="flex transition-transform duration-500 ease-out gap-5" style="transform: translateX(0px);">
          {testimonios.map((t) => (
            <div
              class="testimonio-card w-full sm:w-[calc(50%-10px)] flex-shrink-0 bg-[rgba(255,255,255,0.04)] border border-[rgba(255,255,255,0.07)] hover:border-[rgba(245,197,24,0.2)] hover:bg-[rgba(245,197,24,0.03)] p-6 sm:p-8 rounded-2xl relative flex flex-col justify-between transition-all duration-300 backdrop-blur-sm"
              id={`testimonio-${t.id}`}
            >
              <!-- Decorative quote -->
              <span class="absolute top-5 right-6 text-7xl font-serif text-[rgba(255,255,255,0.04)] leading-none select-none" aria-hidden="true">"</span>

              <div>
                <!-- Stars -->
                <div class="flex gap-1 mb-5" aria-label={`Calificación de ${t.rating} estrellas`}>
                  {Array.from({ length: t.rating }).map(() => (
                    <svg class="w-4 h-4 text-[#F5C518] fill-current" viewBox="0 0 20 20" aria-hidden="true">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>

                <!-- Text -->
                <p class="text-[rgba(245,245,245,0.75)] text-sm sm:text-base italic leading-relaxed mb-6 font-light">
                  "{t.texto}"
                </p>
              </div>

              <!-- Author details -->
              <div class="flex items-center gap-4 mt-4 pt-4 border-t border-[rgba(255,255,255,0.06)]">
                <div class="w-11 h-11 bg-gradient-to-br from-[#F5C518] to-[#E8A000] rounded-full flex items-center justify-center text-[#111111] font-bold text-sm shadow-md shadow-[rgba(245,197,24,0.15)] select-none flex-shrink-0">
                  {t.avatar}
                </div>
                <div>
                  <h3 class="font-bold text-white text-sm tracking-wide uppercase font-['Barlow_Condensed']">{t.nombre}</h3>
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-[rgba(245,245,245,0.45)] mt-0.5">
                    <span>{t.rol}</span>
                    <span class="text-[rgba(245,197,24,0.4)]">·</span>
                    <span class="text-[#F5C518] font-semibold">{t.servicio}</span>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Navigation Arrows -->
      <button
        id="prev-testimonio-btn"
        class="absolute -left-2 sm:-left-5 top-1/2 -translate-y-1/2 w-11 h-11 bg-[rgba(255,255,255,0.05)] hover:bg-[#F5C518] border border-[rgba(255,255,255,0.1)] hover:border-[#F5C518] rounded-full flex items-center justify-center text-white hover:text-[#111111] shadow-xl transition-all duration-250 hover:scale-110 z-20 cursor-pointer"
        aria-label="Opinión anterior"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        id="next-testimonio-btn"
        class="absolute -right-2 sm:-right-5 top-1/2 -translate-y-1/2 w-11 h-11 bg-[rgba(255,255,255,0.05)] hover:bg-[#F5C518] border border-[rgba(255,255,255,0.1)] hover:border-[#F5C518] rounded-full flex items-center justify-center text-white hover:text-[#111111] shadow-xl transition-all duration-250 hover:scale-110 z-20 cursor-pointer"
        aria-label="Siguiente opinión"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Dots -->
      <div id="testimonios-dots" class="flex justify-center gap-2 mt-8"></div>
    </div>
  </div>
</section>

<script>
  let indexActual = 0;
  const track = document.getElementById('testimonios-track');
  const cards = document.querySelectorAll('.testimonio-card');
  const prevBtn = document.getElementById('prev-testimonio-btn');
  const nextBtn = document.getElementById('next-testimonio-btn');
  const dotsContainer = document.getElementById('testimonios-dots');

  if (track && cards.length > 0 && prevBtn && nextBtn && dotsContainer) {
    let cartasVisibles = 2;

    function actualizarDimensiones() {
      cartasVisibles = window.innerWidth < 640 ? 1 : 2;
      crearPuntos();
      irAlIndice(indexActual);
    }

    function crearPuntos() {
      dotsContainer.innerHTML = '';
      const totalPuntos = cards.length - cartasVisibles + 1;
      for (let i = 0; i < totalPuntos; i++) {
        const dot = document.createElement('button');
        dot.className = `h-2 rounded-full transition-all duration-300 cursor-pointer ${i === indexActual ? 'bg-[#F5C518] w-6' : 'bg-[rgba(255,255,255,0.2)] w-2'}`;
        dot.setAttribute('aria-label', `Ir al grupo de opiniones ${i + 1}`);
        dot.addEventListener('click', () => irAlIndice(i));
        dotsContainer.appendChild(dot);
      }
    }

    function irAlIndice(nuevoIndice: number) {
      const totalPuntos = cards.length - cartasVisibles + 1;
      if (nuevoIndice < 0) indexActual = totalPuntos - 1;
      else if (nuevoIndice >= totalPuntos) indexActual = 0;
      else indexActual = nuevoIndice;

      const gap = 20;
      const firstCard = cards[0] as HTMLElement;
      if (firstCard && track) {
        const anchoTarjeta = firstCard.getBoundingClientRect().width;
        track.style.transform = `translateX(-${indexActual * (anchoTarjeta + gap)}px)`;
      }

      const dots = dotsContainer.children;
      Array.from(dots).forEach((dotEl, i) => {
        const dot = dotEl as HTMLElement;
        if (i === indexActual) {
          dot.classList.add('bg-[#F5C518]', 'w-6');
          dot.classList.remove('bg-[rgba(255,255,255,0.2)]', 'w-2');
        } else {
          dot.classList.remove('bg-[#F5C518]', 'w-6');
          dot.classList.add('bg-[rgba(255,255,255,0.2)]', 'w-2');
        }
      });
    }

    prevBtn.addEventListener('click', () => irAlIndice(indexActual - 1));
    nextBtn.addEventListener('click', () => irAlIndice(indexActual + 1));

    let startX = 0;
    track.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    track.addEventListener('touchend', (e) => {
      const diff = startX - e.changedTouches[0].clientX;
      if (diff > 50) irAlIndice(indexActual + 1);
      else if (diff < -50) irAlIndice(indexActual - 1);
    }, { passive: true });

    window.addEventListener('resize', actualizarDimensiones, { passive: true });
    actualizarDimensiones();
  }
</script>
